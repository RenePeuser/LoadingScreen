<Window x:Class="LoadingScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ProgressBar HorizontalAlignment="Left" Height="33" Margin="104,106,0,0" VerticalAlignment="Top" Width="259" Value="{Binding Value, ElementName=slider}"/>
        <Slider x:Name="slider" HorizontalAlignment="Left" Height="32" Margin="120,182,0,0" VerticalAlignment="Top" Width="243" Maximum="100"/>

    </Grid>
</Window>
